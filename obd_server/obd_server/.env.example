# Скопіюй цей файл у .env і впиши свої значення.
# У паролі не використовуй спецсимволи (@ : / # %), або закодуй їх для URL.
DATABASE_URL=postgresql+psycopg://obd_admin:ТВІЙ_ПАРОЛЬ@localhost:5432/obd

# Довгий випадковий рядок для підпису токенів. Згенерувати:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ЗАМІНИ_МЕНЕ

# Скільки хвилин діє токен входу (за замовчуванням 1 доба)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Ключі довідників авто (необов'язково; без них VIN шукається в безкоштовній базі NHTSA, а пошук за номером вимкнений)
AUTODEV_API_KEY=
BAZAGAI_API_KEY=

# Ключ для ШІ-пояснень прогнозу (https://console.anthropic.com). Можна лишити порожнім: тоді текст формується за шаблоном.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# Безкоштовний варіант: ключ Google Gemini з https://aistudio.google.com/apikey (має пріоритет над Anthropic)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
